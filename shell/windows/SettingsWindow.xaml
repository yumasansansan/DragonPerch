<Window
    x:Class="DragonPerch.Shell.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto" Background="Transparent">

        <!--
            Every colour, radius and thickness below is a system theme resource rather than
            a value of ours. That is the whole difference between being Fluent and looking
            like it: these follow the user's theme, accent colour and contrast settings
            without a line of code, and they are where the Community Toolkit's SettingsCard
            gets its own appearance from.
        -->
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
                <Setter Property="Padding" Value="16,12"/>
            </Style>
            <!--
                BasedOn, not a Setter for the Style property: a Style cannot set Style, and
                XAML does not say so at build time. It throws InvalidCastException when the
                window is constructed, which reaches a menu click handler and takes the
                whole process with it.
            -->
            <Style x:Key="CardTitle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}"/>
            <Style x:Key="CardNote" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </Grid.Resources>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent" VerticalAlignment="Top">
            <TextBlock Text="DragonPerch" Margin="16,0,0,0" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="DragonPerch"
                   Style="{ThemeResource TitleTextBlockStyle}"
                   Margin="28,24,28,12"/>

        <ScrollViewer Grid.Row="2" Padding="28,0,28,0">
            <StackPanel Spacing="4">

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="Dragons per mascot"/>
                            <TextBlock Style="{StaticResource CardNote}"
                                       Text="Three mascots at two each is six dragons."/>
                        </StackPanel>
                        <NumberBox x:Name="PetsBox" Grid.Column="1" Width="128"
                                   VerticalAlignment="Center"
                                   Minimum="0" Maximum="64" SmallChange="1" LargeChange="5"
                                   SpinButtonPlacementMode="Compact"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Mascots"/>
                            <TextBlock Style="{StaticResource CardNote}"
                                       Text="Which dragons walk. Turning all of them off is the same as turning all of them on."/>
                        </StackPanel>
                        <StackPanel x:Name="MascotList" Spacing="2"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="Walking speed"/>
                            <TextBlock Style="{StaticResource CardNote}"
                                       Text="Pixels per second. The walk cycle was drawn against 42: much faster and the feet slide, much slower and it moonwalks."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <Slider x:Name="SpeedSlider" Width="200"
                                    Minimum="1" Maximum="200" StepFrequency="1"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="SpeedValue" Width="40"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource BodyTextBlockStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="Pause now and then"/>
                            <TextBlock Style="{StaticResource CardNote}"
                                       Text="Mean seconds between spontaneous pauses. Zero stops them happening at all."/>
                        </StackPanel>
                        <NumberBox x:Name="IdleBox" Grid.Column="1" Width="128"
                                   VerticalAlignment="Center"
                                   Minimum="0" Maximum="3600" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Compact"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Monitors"/>
                            <TextBlock Style="{StaticResource CardNote}"
                                       Text="Where the dragons are allowed. Turning all of them off is the same as turning all of them on."/>
                        </StackPanel>
                        <StackPanel x:Name="OutputList" Spacing="2"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="Get out of the way of full-screen apps"/>
                            <TextBlock Style="{StaticResource CardNote}"
                                       Text="Hide the dragons on a monitor showing something full screen."/>
                        </StackPanel>
                        <ToggleSwitch x:Name="FullscreenToggle" Grid.Column="1"
                                      VerticalAlignment="Center" OnContent="" OffContent=""/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,16">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <InfoBar x:Name="Status" Grid.Column="0"
                         IsOpen="False" IsClosable="False" Severity="Success"
                         VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Grid.Column="1" Content="Close" Click="OnClose"/>
                <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply"
                        Style="{ThemeResource AccentButtonStyle}" Click="OnApply"/>
            </Grid>
        </Border>

    </Grid>
</Window>
