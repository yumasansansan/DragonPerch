[Desktop Entry]
Type=Application
Name=DragonPerch
GenericName=Desktop pets
Comment=Konqi and friends romp across your window title bars and panels
Exec=dragonperch-wl
Icon=dragonperch
Categories=Utility;Amusement;
Terminal=false

# Not autostarted by installing it. A program that puts dragons on somebody's screen the
# next time they log in, because a package happened to be pulled in, is a program that gets
# uninstalled. Copy this into ~/.config/autostart/ to have it start with the session.
X-KDE-autostart-phase=2
