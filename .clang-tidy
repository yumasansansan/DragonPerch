# SPDX-License-Identifier: GPL-3.0-or-later
#
# clang-tidy, for the half of this project MSVC's /analyze never sees.
#
# The Windows head has had a static analyser since the compiler options were written --
# /analyze is on, warnings-as-errors, and it is what forced check_handle into
# win_headers.hpp. The Wayland head and the core had nothing. This is that.
#
# Which checks, decided by running them rather than by taste. On the core as it stands:
#
#   bugprone-* clang-analyzer-* cert-* concurrency-*      7 findings
#   performance-*                                         2
#   portability-*                                        13
#   misc-*                                               82
#   cppcoreguidelines-*                                  96
#   readability-*                                       132
#   modernize-*                                         166
#
# The first line is a gate somebody can keep green. The rest are a style argument with
# four hundred opinions in it, and mixing the two would mean the gate is never green and
# therefore never read. They are deliberately out; turning one on is a separate piece of
# work with a separate discussion.
#
# The seven that first line found: one real bug (two_places rounded with the
# (x + 0.5)-truncated idiom, which lands a unit high just below a .5 boundary), and six
# excluded below with reasons.

Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  performance-*,
  portability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -performance-enum-size,
  -portability-avoid-pragma-once

# Four exclusions, each for its own reason. The families they are in stay on, because the
# other checks in them are worth having.
#
# bugprone-easily-swappable-parameters is an API-shape opinion, not a bug finder: it fires
# on any function taking two adjacent parameters of the same type, of which a geometry
# library has rather a lot.
#
# bugprone-exception-escape fires on SpritePack's implicit move constructor, through
# std::map's -- but only with MSVC's standard library, whose map move allocates a sentinel
# node and can therefore throw bad_array_new_length. libstdc++'s does not. The finding is a
# property of one implementation of the standard library, not of this code.
#
# performance-enum-size wants EdgeKind and PetState to be std::uint8_t. Measured before
# deciding, and the answer is that it changes nothing: the enums do shrink from 4 bytes to
# 1, and sizeof(WalkableEdge) stays 32 and sizeof(Pet) stays 80, because padding absorbs
# all of it. A change with no effect is worse than no change; it looks like it did
# something.
#
# portability-avoid-pragma-once wants include guards. #pragma once is supported by every
# compiler this project targets and by every one it plausibly could; the check exists for
# toolchains that are not among them. Twenty-five headers would grow three lines each to
# satisfy a portability concern this project does not have.

WarningsAsErrors: '*'

# Ours only. Everything under _deps/ is Catch2, and the Windows SDK headers arrive through
# win_headers.hpp; neither is this project's to fix.
#
# Both separators in the class, because clang-tidy prints the path the compiler was given.
# On Windows that is `src/core\dragonperch\geometry.hpp`, mixed, and a pattern with only
# `/` in it silently matches nothing -- which is how a local run of this file reported no
# findings at all while CI reported eleven.
HeaderFilterRegex: '.*(src|fuzz)[/\\].*'

FormatStyle: none
